#!/bin/bash
# git-credential: the credential helper a depot's git runs for github.com.
# The import copies it beside the declaration, under
# <home>/sources/github/github/git-credential, and a depot whose origin is
# on github.com points its own git at the copy:
#   git -C <depot> config credential."https://github.com".helper <the copy>
# (in that depot's own .git/config alone, never --global: packs/github/SETUP.md).
# Git runs it with get, store or erase and its request (protocol, host, ...)
# on stdin. For protocol https and host github.com it answers username
# x-access-token and the GITHUB_TOKEN read from the github source's env
# file at the moment git asks, so a rotated token needs no re-turn-on;
# for any other host or protocol it answers nothing, and store and erase
# do nothing. The token is read as the core reads it (last GITHUB_TOKEN
# line wins, surrounding whitespace off, an empty value as good as unset)
# and is printed only to git on stdout: never in an argument, a file, a
# log or an error. Needs nothing but bash.
set -euo pipefail

# trim prints its argument without surrounding whitespace, as the core
# trims a credential's value before it is used.
trim() {
  local v=$1
  v=${v#"${v%%[![:space:]]*}"}
  v=${v%"${v##*[![:space:]]}"}
  printf '%s' "$v"
}

# yard_home is the yard's home: three directories above this helper as the
# import copied it (<home>/sources/github/github/git-credential), else
# YARDR_HOME, else the default home. The copy knows where it stands, so
# the helper needs no environment of its own.
yard_home() {
  local self=$1 link dir
  case $self in
  */*) ;;
  *) self=$(command -v "$self" || printf '%s' "$self") ;;
  esac
  while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
    esac
  done
  case $self in
  /*) ;;
  *) self=$PWD/$self ;;
  esac
  case $self in
  */sources/github/github/git-credential)
    dir=${self%/sources/github/github/git-credential}
    [ -n "$dir" ] && printf '%s' "$dir" && return 0
    ;;
  esac
  printf '%s' "${YARDR_HOME:-$HOME/.yardr}"
}

op=${1:-}
case $op in
store | erase) exit 0 ;;
get) ;;
*)
  echo "usage: git-credential {get|store|erase} (run by git, not by hand)" >&2
  exit 2
  ;;
esac

# Git's request: key=value lines to a blank line. Only protocol and host
# matter here; anything else is git's own.
protocol=""
host=""
while IFS= read -r line || [ -n "$line" ]; do
  line=${line%$'\r'}
  [ -n "$line" ] || break
  case $line in
  protocol=*) protocol=${line#protocol=} ;;
  host=*) host=${line#host=} ;;
  esac
done
if [ "$protocol" != "https" ] || [ "$host" != "github.com" ]; then
  exit 0
fi

envfile=$(yard_home "$0")/sources/github.env
raw=""
if [ -f "$envfile" ]; then
  n=0
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line=${line%$'\r'}
    line=${line#"${line%%[![:space:]]*}"}
    case $line in
    '' | '#'*) continue ;;
    esac
    case $line in
    *=*) k=${line%%=*} v=${line#*=} ;;
    *)
      echo "git-credential: $envfile line $n: want KEY=VALUE" >&2
      exit 0
      ;;
    esac
    k=$(trim "$k")
    case $k in
    '' | *[!A-Za-z0-9_]* | [0-9]*)
      echo "git-credential: $envfile line $n: want KEY=VALUE" >&2
      exit 0
      ;;
    esac
    if [ "$k" = "GITHUB_TOKEN" ]; then
      raw=$v
    fi
  done <"$envfile"
fi
token=$(trim "$raw")
if [ -z "$token" ]; then
  echo "git-credential: GITHUB_TOKEN is not set in $envfile" >&2
  exit 0
fi
printf 'username=%s\npassword=%s\n' "x-access-token" "$token"
