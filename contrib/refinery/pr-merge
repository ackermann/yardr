#!/bin/sh
# pr-merge: lands an epic by merging its pull request on GitHub with a
# rebase, then brings the rig's local base up to it. Run it as the cmd of an
# exec group (yard-pr-merge, limit 1) routed for the epic flow's land stage
# (type epic). An epic reaches land from in-pr, where a human (or, later,
# the daemon on a green CI) says "merge it". See docs/pipeline.md, section
# Epics.
#
# The pull-request path is experimental and off by default: without
# YARDR_PR in the group's cmd, as for integrate-epic, the epic is held with
# a note and nothing is merged.
#
# It reads the environment the exec runner gives it: YARDR_BEAD (the epic),
# YARDR_RIG_PATH, YARDR_BASE, YARDR_BRANCH and YARDR_BIN. Options, set in
# the group's cmd:
#
#   YARDR_PR       1: the switch for the pull-request path; held without it
#   YARDR_PUSH     the remote the pull request is on (default origin)
#
# It runs gh pr merge <pr_url> --rebase --delete-branch --match-head-commit
# <pr_reviewed_sha>, then fetches the remote and fast-forwards the base in
# the rig's checkout, and reports done (-> merged, which closes the epic).
# The sha is the commit pr-epic pushed and stored when the epic entered
# in-pr: only what the reviewer approved is merged. A pull request whose
# head is another commit, before the merge or when GitHub refuses it for
# that, holds the epic, unmerged; an epic with no reviewed sha reports
# failed. A merge GitHub refuses for anything else (checks
# pending, review required, conflicts) reports failed (-> open) with gh's
# message, once: nothing here retries. The rig's checkout must be on the
# base and clean, or the epic is held before anything is merged; a base
# that will not fast-forward after the merge is held too, as the PR is
# merged by then. The PR is the one the epic is bound to (pr_number,
# pr_head_repo, stored by integrate-epic): an epic bound to none reports
# failed, and one whose pr_url is another pull request is held, unmerged.
# Needs gh, logged in as the operator, and jq on PATH.
#
# Every outcome ends in a report or a hold: exiting without one counts as a
# failed session, and three of those hold the bead.
set -u
# A dir rig (YARDR_RIG_KIND=dir) has no branches: there is nothing here to
# land, integrate or open a pull request for. A route that hands one over is
# a mistake in the rig's flow, so refuse to run (exit 2) rather than guess.
if [ "${YARDR_RIG_KIND:-git}" = dir ]; then
  echo "pr-merge: rig ${YARDR_RIG:-?} is a dir rig, with no branch to work on; route its stages to other groups" >&2
  exit 2
fi
: "${YARDR_BEAD:?not run by an exec group}" "${YARDR_RIG_PATH:?bead has no rig}" "${YARDR_BASE:?}"
Y=${YARDR_BIN:-yardr}
EPIC=$YARDR_BEAD
REPO=$YARDR_RIG_PATH
BASE=$YARDR_BASE
BR=${YARDR_BRANCH:-yard/$EPIC}
PUSH=${YARDR_PUSH:-origin}
echo "== $(date -Is) pr-merge $EPIC ($BR)"

# Reporting ends this session (the daemon stops the script), so it is
# always the last thing done.
hold() { echo "== hold $EPIC: $1"; "$Y" bead note "$EPIC" "pr: $1"; "$Y" bead hold "$EPIC"; exit 0; }
report() {
  echo "== $EPIC $1"
  printf '%s\n' "pr: $2" | "$Y" bead done "$EPIC" --outcome "$1" --note - && exit 0
  hold "could not report $1 (does the epic's flow name it for its stage?): $2"
}
errf=$(mktemp) && trap 'rm -f "$errf"' EXIT

# Off unless switched on: an epic that reached land by accident (a stray
# route, a move by hand) must not be merged on GitHub.
[ -n "${YARDR_PR:-}" ] ||
  hold "the pull-request path is experimental and off: YARDR_PR is not set in this group's cmd; not merging. Set YARDR_PR=1 in the cmd of every group on the path, then unhold, or send the epic back to open and land it through the refinery (merge-local)."

# The base branch, without its remote: what the PR merged into and what the
# rig's checkout must be on.
prbase=$BASE
remote=${BASE%%/*}
[ "$remote" != "$BASE" ] && git -C "$REPO" remote | grep -qx "$remote" && prbase=${BASE#*/}

# The checkout is checked before merging: once GitHub has merged, a
# checkout that cannot follow would leave the epic merged there but not here.
[ "$(git -C "$REPO" symbolic-ref -q --short HEAD)" = "$prbase" ] ||
  hold "$REPO is not on $prbase; not merging. Check out $prbase there, then unhold."
[ -z "$(git -C "$REPO" status --porcelain)" ] ||
  hold "$REPO has uncommitted changes; not merging. Commit or clean them, then unhold."

epic=$("$Y" bead show "$EPIC" --json) || hold "reading $EPIC failed"
# The epic's pull request is the one integrate-epic bound it to, by number
# and head repository, never one looked up by the branch's name: a fork's
# pull request can carry the same name. What GitHub says of it must match
# the binding, or it is not the epic's to merge.
url=$(printf '%s' "$epic" | jq -r '.metadata.pr_url // empty')
num=$(printf '%s' "$epic" | jq -r '.metadata.pr_number // empty')
headrepo=$(printf '%s' "$epic" | jq -r '.metadata.pr_head_repo // empty')
[ -n "$url" ] && [ -n "$num" ] && [ -n "$headrepo" ] ||
  report failed "no pull request bound to $EPIC (pr_url, pr_number, pr_head_repo): integrating the epic again opens one, or binds the one in pr_url"
pr=$(cd "$REPO" && gh pr view "$url" --json number,state,headRefName,headRefOid,headRepositoryOwner,headRepository 2>"$errf") ||
  report failed "reading pull request $url failed: $(cat "$errf")"
is="#$(printf '%s' "$pr" | jq -r .number) from $(printf '%s' "$pr" | jq -r 'if .headRepositoryOwner.login and .headRepository.name then .headRepositoryOwner.login + "/" + .headRepository.name else empty end'):$(printf '%s' "$pr" | jq -r .headRefName)"
[ "$is" = "#$num from $headrepo:$BR" ] ||
  hold "pull request $url is $is, but $EPIC is bound to #$num from $headrepo:$BR. Not touched. Correct the epic's pr_url, pr_number and pr_head_repo, then unhold."

# Only the commit the reviewer approved is merged: the one pr-epic pushed
# and stored when the epic entered in-pr. Commits pushed to the pull request
# since were reviewed by no one, so a head that moved is held, not merged
# and not sent round again by itself.
reviewed=$(printf '%s' "$epic" | jq -r '.metadata.pr_reviewed_sha // empty')
[ -n "$reviewed" ] ||
  report failed "$EPIC has no reviewed commit (pr_reviewed_sha, which pr-epic stores as the epic enters in-pr); not merging. It is integrated and reviewed again."
moved() {
  hold "the head of pull request $url is $1, not the reviewed $reviewed (pr_reviewed_sha): it moved after review. Not merged. Look at what was pushed to $BR on $PUSH: to have it reviewed, bring it into $BR in the rig and send the epic back to open, where it is integrated and reviewed again; to drop it, put $PUSH/$BR back at $reviewed, then unhold."
}
head=$(printf '%s' "$pr" | jq -r '.headRefOid // empty')
[ "$head" = "$reviewed" ] || moved "${head:-unknown}"

# --match-head-commit closes the gap between the check above and the merge:
# GitHub refuses when the head is no longer the reviewed commit. gh can
# merge and still exit non-zero (deleting a local branch a worktree has
# checked out, say): what GitHub says the PR is decides.
out=$(cd "$REPO" && gh pr merge "$url" --rebase --delete-branch --match-head-commit "$reviewed" 2>&1) && rc=0 || rc=$?
printf '%s\n' "$out"
if [ "$rc" != 0 ]; then
  state=$(cd "$REPO" && gh pr view "$url" --json state --jq .state 2>/dev/null)
  if [ "$state" != MERGED ]; then
    # Why GitHub refused is read from the head itself, not from gh's wording.
    head=$(cd "$REPO" && gh pr view "$url" --json headRefOid --jq .headRefOid 2>/dev/null)
    [ -z "$head" ] || [ "$head" = "$reviewed" ] || moved "$head"
    report failed "GitHub did not merge $url: $out"
  fi
  echo "== gh exited $rc but $url is merged"
fi

# Bring the local base up to what GitHub merged. Fast-forward only: the
# base gains nothing locally that is not on the remote.
out=$(git -C "$REPO" fetch "$PUSH" 2>&1) ||
  hold "merged $url, but fetching $PUSH failed: $out
Fast-forward $prbase in $REPO to $PUSH/$prbase, then advance the epic to merged."
out=$(git -C "$REPO" merge --ff-only "$PUSH/$prbase" 2>&1) ||
  hold "merged $url, but $prbase in $REPO does not fast-forward to $PUSH/$prbase: $out
Bring $prbase up to $PUSH/$prbase, then advance the epic to merged."
sha=$(git -C "$REPO" rev-parse --short HEAD)

report done "merged $url at the reviewed $reviewed with a rebase; $prbase at $sha"
