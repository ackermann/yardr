#!/bin/sh
# Stand-in for systemctl --user: units are files under SYSTEMCTL_STATE
# (enabled/<name>, active/<name>), every call is logged to calls.log, and
# what the script and `yardr install` do not call fails loudly. With a file
# no-session in the state dir every call fails as it does for a user with no
# systemd session (sudo -u, su without a dash): no bus to connect to.
set -eu
: "${SYSTEMCTL_STATE:?SYSTEMCTL_STATE is not set}"
printf 'systemctl %s\n' "$*" >>"$SYSTEMCTL_STATE/calls.log"
if [ -f "$SYSTEMCTL_STATE/no-session" ]; then
  echo "Failed to connect to bus: No medium found" >&2
  exit 1
fi
[ "${1:-}" = "--user" ] && shift
cmd=${1:-}
[ $# -ge 1 ] && shift
# ensure_runs models the manager starting the unit: herdr's server and the
# daemon really start, detached, logging to the state dir. The web view's
# unit is only marked: starting it would bind 127.0.0.1:8791. A manager
# returns before its process runs: while a file start-hold is in the state
# dir the daemon is not up yet, and starts when the test renames the file to
# start-released (a test that never does has a unit that never starts).
ensure_runs() {
  case "$1" in
  herdr)
    herdr status server >/dev/null 2>&1 || {
      herdr server >>"$SYSTEMCTL_STATE/herdr.log" 2>&1 &
      echo $! >"$SYSTEMCTL_STATE/herdr.pid"
    }
    ;;
  yardr-daemon-*)
    # The redirection is the subshell's own, so that the pipes of the caller
    # are not held open while it waits: the call must return at once. The
    # hold ending is not the release: removing the state dir at the end of a
    # test unlinks start-hold a moment before the dir, and a daemon started in
    # that moment runs in a home that is being removed and leaves it behind.
    # So the daemon starts only for a start-released, which is what the test
    # renames the hold to, and the wait ends without one with the state dir or
    # after a minute (a test that was killed).
    (
      if [ -f "$SYSTEMCTL_STATE/start-hold" ]; then
        echo "fake systemctl: the daemon is held back until start-released"
        i=0
        while [ -f "$SYSTEMCTL_STATE/start-hold" ] && [ "$i" -lt 600 ]; do
          i=$((i + 1))
          sleep 0.1
        done
        [ -f "$SYSTEMCTL_STATE/start-released" ] || {
          echo "fake systemctl: the hold ended without start-released; the daemon is not started"
          exit 0
        }
      fi
      exec yardr daemon
    ) >>"$SYSTEMCTL_STATE/daemon.log" 2>&1 &
    ;;
  esac
}
case "$cmd" in
show-environment)
  [ $# -eq 0 ] || { echo "fake systemctl: show-environment takes no argument" >&2; exit 2; }
  echo "PATH=$PATH"
  ;;
daemon-reload)
  [ $# -eq 0 ] || { echo "fake systemctl: daemon-reload takes no unit" >&2; exit 2; }
  ;;
is-enabled)
  [ $# -eq 1 ] || { echo "fake systemctl: is-enabled takes one unit" >&2; exit 2; }
  if [ -f "$SYSTEMCTL_STATE/enabled/$1" ]; then echo enabled; else echo disabled; exit 1; fi
  ;;
is-active)
  [ $# -eq 1 ] || { echo "fake systemctl: is-active takes one unit" >&2; exit 2; }
  if [ -f "$SYSTEMCTL_STATE/active/$1" ]; then echo active; else echo inactive; exit 1; fi
  ;;
enable)
  now=
  [ "${1:-}" = "--now" ] && { now=1; shift; }
  [ $# -eq 1 ] || { echo "fake systemctl: enable takes one unit" >&2; exit 2; }
  mkdir -p "$SYSTEMCTL_STATE/enabled" "$SYSTEMCTL_STATE/active"
  touch "$SYSTEMCTL_STATE/enabled/$1"
  if [ -n "$now" ]; then
    touch "$SYSTEMCTL_STATE/active/$1"
    ensure_runs "$1"
  fi
  ;;
restart | start)
  [ $# -eq 1 ] || { echo "fake systemctl: $cmd takes one unit" >&2; exit 2; }
  mkdir -p "$SYSTEMCTL_STATE/active"
  touch "$SYSTEMCTL_STATE/active/$1"
  ensure_runs "$1"
  ;;
disable)
  [ "${1:-}" = "--now" ] && shift
  [ $# -eq 1 ] || { echo "fake systemctl: disable takes one unit" >&2; exit 2; }
  rm -f "$SYSTEMCTL_STATE/enabled/$1" "$SYSTEMCTL_STATE/active/$1"
  ;;
stop)
  [ $# -eq 1 ] || { echo "fake systemctl: stop takes one unit" >&2; exit 2; }
  rm -f "$SYSTEMCTL_STATE/active/$1"
  ;;
*)
  echo "fake systemctl: no $cmd" >&2
  exit 2
  ;;
esac
