#!/bin/sh
# Stand-in for a harness (claude): it answers its version flag, and a
# one-shot call (-p, what `yardr doctor --try` and the start's own check
# run) with ok. With HERDR_FAKE_STATE/logged-out present the one-shot call
# fails as a harness without its login does. Its version says who it is, as
# Claude Code's does, since a program called claude that does not is no
# harness to yardr (harnesses/claude.yaml, version_contains).
set -eu
: "${HERDR_FAKE_STATE:?HERDR_FAKE_STATE is not set}"
case "${1:-}" in
-p)
  if [ -f "$HERDR_FAKE_STATE/logged-out" ]; then
    echo "error: Not logged in. Run /login to authenticate." >&2
    exit 1
  fi
  echo ok
  ;;
*)
  echo "1.0.0 (Claude Code)"
  ;;
esac
