== env ==
YARDR_ACTOR=web-assembly
YARDR_BASE=main
YARDR_BEAD=api1-standin
YARDR_BIN=<bin>
YARDR_BRANCH=yard/api1-standin
YARDR_DEPOT=web
YARDR_DEPOT_KIND=git
YARDR_DEPOT_PATH=
YARDR_FIXTURE=api1
YARDR_GROUP=web-assembly
YARDR_HOME=<home>
YARDR_SESSION=<session>
YARDR_STAGE=landed
YARDR_TEST=sh .yardr/test
YARDR_TRAIN=
YARDR_TYPE=task
YARDR_WORKTREE=<home>/worktrees/web/api1-standin
== <bin> prime --bead api1-standin --json ==
{
  "bead": {
    "depot": "web",
    "id": "api1-standin",
    "labels": [],
    "priority": 0,
    "stage": "landed",
    "status": "open",
    "title": "the fixture script's bead",
    "type": "task"
  },
  "next": {
    "outcomes": [
      {
        "goes": "merged",
        "name": "done"
      },
      {
        "goes": "new",
        "name": "failed"
      }
    ],
    "stage": "landed",
    "stages": [
      "merged",
      "new",
      "decide"
    ]
  }
}
exit=0
