# Written by `yardr web install` for the yard in /Users/jo/.yardr; `yardr web uninstall` removes it.
[Unit]
Description=yardr web view for /Users/jo/.yardr

[Service]
ExecStart="/Users/jo/go/bin/yardr" "web" "serve" "--addr" "127.0.0.1:8791"
WorkingDirectory=/Users/jo/.yardr
Environment="HOME=/Users/jo"
Environment="PATH=/Users/jo/go/bin:/opt/homebrew/bin:/usr/bin:/bin"
Environment="YARDR_HOME=/Users/jo/.yardr"
Environment="YARD_HOME=/Users/jo/.yardr"
StandardOutput=append:/Users/jo/.yardr/web.log
StandardError=append:/Users/jo/.yardr/web.log
Restart=on-failure
RestartSec=10
KillMode=process

[Install]
WantedBy=default.target
