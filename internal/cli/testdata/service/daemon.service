# Written by `yardr daemon install` for the yard in /Users/jo/.yardr; `yardr daemon uninstall` removes it.
[Unit]
Description=yardr daemon for /Users/jo/.yardr

[Service]
ExecStart="/Users/jo/go/bin/yardr" "daemon"
WorkingDirectory=/Users/jo/.yardr
Environment="HOME=/Users/jo"
Environment="PATH=/Users/jo/go/bin:/opt/homebrew/bin:/usr/bin:/bin"
Environment="YARDR_HOME=/Users/jo/.yardr"
StandardOutput=append:/Users/jo/.yardr/daemon.log
StandardError=append:/Users/jo/.yardr/daemon.log
Restart=on-failure
RestartSec=10
KillMode=process

[Install]
WantedBy=default.target
